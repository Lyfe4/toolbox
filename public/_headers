# Cloudflare Pages `_headers` file.
# Copied verbatim into the build output, applied to every response.
#
# Patchbay's core promise is that nothing you paste ever leaves your machine.
# That promise is enforced here by the browser, not merely asserted in the
# README - if application code ever tried to phone home, the request would be
# blocked rather than silently succeed.
#
# {{INLINE_SCRIPT_HASHES}} below is replaced at build time by vite/plugins/
# csp-hash.ts with the sha256 of the theme-bootstrap script in index.html.
# The placeholder is not a valid CSP source, so a build that somehow skipped
# the plugin yields an obviously broken policy rather than a silently
# permissive one.

/*
  # --- Content Security Policy ------------------------------------------------
  # default-src 'self'        Everything not named below may only load from this
  #                           origin. The catch-all that makes the rest additive.
  # script-src                Own scripts only, plus the exact hash of the one
  #                           inline bootstrap script. No 'unsafe-inline', so an
  #                           injected <script> or onclick= cannot execute.
  #                           'wasm-unsafe-eval' permits WebAssembly compilation
  #                           (and only that) for the WASM-backed tools to come.
  # style-src 'self'          Stylesheets come from our own bundle. No inline
  #                           <style> blocks and no style="" attributes.
  #                           NOTE: no style-src-attr exception is needed. React
  #                           applies the `style` prop through the CSSOM
  #                           (element.style.setProperty), which CSP does not
  #                           govern - only style attributes present in parsed
  #                           markup are. Verified against the built app with
  #                           these exact headers; zero violations.
  # img-src 'self' data: blob:  Tool output (previews, generated images) is held
  #                           in memory as data:/blob: URLs, never uploaded.
  # font-src 'self'           Self-hosted fonts only. No Google Fonts, no CDN.
  # connect-src 'none'        The zero-network guarantee: fetch, XHR, WebSocket,
  #                           EventSource and sendBeacon are all refused.
  #                           NOTE: when ffmpeg.wasm lands this may have to
  #                           become 'self' so its .wasm payload can be fetched
  #                           from our own origin. It must never widen further.
  # worker-src 'self'         Heavy processing moves to Web Workers. Same-origin
  #                           worker scripts only - an inline/blob: worker would
  #                           be a way to run unreviewed code, so it stays out.
  # child-src 'self'          Legacy fallback for worker-src in older engines.
  # object-src 'none'         No <object>/<embed>. Legacy plugin attack surface.
  # base-uri 'self'           A <base> tag cannot be injected to re-point every
  #                           relative URL on the page at an attacker's origin.
  # form-action 'none'        No form may submit anywhere. Nothing to submit to.
  # frame-ancestors 'none'    Nobody may iframe Patchbay - blocks clickjacking.
  # frame-src 'none'          Patchbay embeds nobody either.
  # manifest-src 'self'       PWA manifest from our origin only.
  # upgrade-insecure-requests Any stray http:// subresource is upgraded to https.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' {{INLINE_SCRIPT_HASHES}}; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'none'; worker-src 'self'; child-src 'self'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; frame-src 'none'; manifest-src 'self'; upgrade-insecure-requests

  # --- Cross-origin isolation ---------------------------------------------------
  # Together these two put the page in a "cross-origin isolated" state, which is
  # the precondition for SharedArrayBuffer and therefore for multi-threaded
  # WASM (ffmpeg.wasm). Set now, before any code exists, so nothing is ever
  # built against the assumption that isolation is off - turning it on later
  # tends to break every third-party embed at once.
  # COOP  severs the window.opener relationship with cross-origin openers.
  # COEP  refuses cross-origin subresources unless they explicitly opt in.
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp

  # Completes the isolation set: our own documents may only be read by us.
  Cross-Origin-Resource-Policy: same-origin

  # --- Transport and metadata ---------------------------------------------------
  # Trust the declared Content-Type. Stops a .txt being sniffed as executable JS.
  X-Content-Type-Options: nosniff

  # Send no Referer header at all. Outbound navigations learn nothing about
  # which tool the user was on.
  Referrer-Policy: no-referrer

  # Drop capabilities the app has no use for, so a compromise cannot reach them.
  # interest-cohort=() additionally opts out of FLoC/Topics ad profiling.
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=(), payment=(), usb=(), midi=(), serial=(), bluetooth=()
